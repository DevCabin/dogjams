{
  "manifest_version": 3,
  "name": "DogJams Product Scraper",
  "version": "1.1",
  "description": "Scrape product information from TEMU and send it to your DogJams site",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to DogJams"
  },
  "content_scripts": [
    {
      "matches": ["https://www.temu.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://dogjams.com/*",
    "https://*.dogjams.com/*",
    "http://localhost:8000/*"
  ]
}
